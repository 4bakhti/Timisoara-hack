{
  "name": "framewise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node tools/copy-vision-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts --no-error-on-unmatched-pattern",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "voice:clips": "node --env-file-if-exists=.env.local --import tsx scripts/generate-voice-clips.ts",
    "voice:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-voice-agent.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "@elevenlabs/client": "1.36.1",
    "@google/genai": "^3.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "suncalc": "^2.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
