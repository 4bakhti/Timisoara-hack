# Copy to .env.local and fill in. Never commit .env.local.
# Every value is optional: without a key, that feature answers with sample data or is hidden.

# Google Gemini API — scene reading, shot planning, review
GEMINI_API_KEY=

# ElevenLabs — the coach's voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional voice from the project workspace with a Romanian accent.
ELEVENLABS_VOICE_ID_RO=
# Private project agent for the optional microphone conversation.
ELEVENLABS_AGENT_ID=

# PostgreSQL (Tiger Data) — recipes, feedback, usage numbers
DATABASE_URL=
# Explicitly supplied disposable test database; never use production here.
TEST_DATABASE_URL=
# Server-only random token for the team's recipe moderation endpoint.
RECIPES_ADMIN_TOKEN=

# Auth0 — sign-in
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
